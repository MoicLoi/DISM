CREATE TABLE schedule_adaptation (
    item_id TEXT NOT NULL PRIMARY KEY,

    payload_json TEXT NOT NULL,

    persisted_at_epoch_ms INTEGER NOT NULL,

    schema_version INTEGER NOT NULL
);

CREATE INDEX schedule_adaptation_persisted_idx
ON schedule_adaptation(persisted_at_epoch_ms);

insertOrReplace:
INSERT OR REPLACE INTO schedule_adaptation(
    item_id,
    payload_json,
    persisted_at_epoch_ms,
    schema_version
)
VALUES (?, ?, ?, ?);

selectByItemId:
SELECT *
FROM schedule_adaptation
WHERE item_id = ?;

selectAll:
SELECT *
FROM schedule_adaptation
ORDER BY item_id;

deleteByItemId:
DELETE FROM schedule_adaptation
WHERE item_id = ?;

deleteAll:
DELETE FROM schedule_adaptation;
